<Window x:Class="ScreenMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenMaster"
        Title="ScreenMaster" Icon="Assets/ScreenMaster.ico"
        Height="450" Width="780" MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:WallpaperPreviewConverter x:Key="WallpaperPreviewConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
            <Button x:Name="RefreshInfoButton" Content="Refresh Info" Width="112" Padding="12,4" Margin="0,0,8,0"
                    Click="RefreshInfo_Click" />
            <Button x:Name="ApplySaveButton" Content="Apply&amp;Save" Width="112" Padding="12,4"
                    Click="ApplySave_Click" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="0,10,8,8" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Name / ID" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Resolution / Hz" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Background" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="MonitorList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,12,8,12" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Apply Wallpaper" Click="ApplyWallpaper_Click">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WallpaperPath}" Value="{x:Null}">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Clear Wallpaper" Click="ClearWallpaper_Click" />
                                            <MenuItem Header="Remove Screen" Click="RemoveMonitor_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EAF3FF" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                    <Setter Property="Background" Value="#FFF0F0" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnected}" Value="False" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#FFE2E2" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="108" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PrimaryMarker}" FontFamily="Segoe UI Symbol"
                                                   FontSize="40" Foreground="#B77900" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" AutomationProperties.Name="{Binding PrimaryLabel}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Id}" Foreground="#666666" FontSize="11"
                                                       Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Resolution}" />
                                            <TextBlock Text="{Binding RefreshRateLabel}" Foreground="#666666"
                                                       FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Width="112" Height="70" Margin="8,0,0,0" Padding="3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                AutomationProperties.Name="Choose wallpaper" Click="WallpaperPreview_Click">
                                            <Image Source="{Binding WallpaperPath, Converter={StaticResource WallpaperPreviewConverter}}"
                                                   Stretch="UniformToFill" ClipToBounds="True" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="MonitorMessage" Margin="12" TextWrapping="Wrap"
                               Foreground="#666666" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
